#!/usr/bin/env python3
"""Missing-only 20:30 feedback prompt. This worker never writes health data."""
import hashlib
import json
import math
import os
import re
import stat
import subprocess
import sys
import tempfile
from datetime import datetime
from pathlib import Path
from zoneinfo import ZoneInfo

TZ = ZoneInfo(os.environ.get("HERMES_TIMEZONE", "UTC"))
DATA_DIR = Path(os.environ.get(
    "HERMES_DATA_DIR", Path.home() / ".local" / "share" / "hermes"
))
VAULT = Path(os.environ.get("VAULT_DIR", DATA_DIR / "vault"))
HEALTH = Path(os.environ.get("HERMES_HEALTH_CLI", "/opt/hermes/toolkit/health.py"))
RUNTIME = Path(os.environ.get("HERMES_FEEDBACK_RUNTIME", DATA_DIR / "runtime" / "evening-feedback"))
FIELDS = ("day_rating", "whole_day_word", "mood", "pain_change")
PAIN_ID = re.compile(r"[a-z0-9][a-z0-9-]{0,79}")


def emit(value, code=0):
    print(json.dumps(value, sort_keys=True))
    raise SystemExit(code)


def fail(message):
    emit({"ok": False, "error": message}, 1)


def _configure_paths():
    global VAULT, HEALTH, RUNTIME
    keys = ("HERMES_FEEDBACK_VAULT", "HERMES_FEEDBACK_HEALTH",
            "HERMES_FEEDBACK_RUNTIME")
    VAULT = Path(os.environ.get("HERMES_FEEDBACK_VAULT", VAULT))
    HEALTH = Path(os.environ.get("HERMES_FEEDBACK_HEALTH", HEALTH))
    RUNTIME = Path(os.environ.get("HERMES_FEEDBACK_RUNTIME", RUNTIME))


def _regular(path):
    if path.is_symlink():
        fail(f"symlink refused: {path}")
    try:
        st = path.stat()
    except OSError as exc:
        fail(f"required executable unavailable: {exc}")
    if not stat.S_ISREG(st.st_mode):
        fail("regular executable required")


def _status(day):
    _regular(HEALTH)
    try:
        run = subprocess.run([sys.executable, str(HEALTH), "feedback-status", "--date", day],
                             cwd=VAULT, capture_output=True, text=True, timeout=45)
    except (OSError, subprocess.TimeoutExpired) as exc:
        fail(f"feedback status unavailable: {exc.__class__.__name__}")
    if run.returncode != 0:
        fail("feedback status command failed")
    try:
        value = json.loads(run.stdout)
    except ValueError:
        fail("feedback status returned invalid JSON")
    if not isinstance(value, dict) or value.get("ok") is not True or value.get("date") != day:
        fail("feedback status returned the wrong date")
    fields = value.get("prompt_fields")
    if not isinstance(fields, list) or any(not isinstance(field, str) for field in fields) or \
            fields != [field for field in FIELDS if field in fields] or \
            len(fields) != len(set(fields)):
        fail("feedback status returned invalid prompt fields")
    if value.get("complete_for_prompt") is not (not fields):
        fail("feedback status returned inconsistent completeness")
    pain = value.get("pain_followup_due", [])
    if not isinstance(pain, list) or len(pain) > 2:
        fail("feedback status returned invalid pain follow-ups")
    if ("pain_change" in fields) is not bool(pain):
        fail("feedback status returned inconsistent pain completeness")
    return value


def _prompt(status):
    fields = status["prompt_fields"]
    pieces = []
    if "day_rating" in fields:
        pieces.append("day rating: green, yellow, or red")
    if "whole_day_word" in fields:
        pieces.append("your word today: kept, partly, or broke (optional short why)")
    if "mood" in fields:
        pieces.append("mood right now: 1–5")
    if "pain_change" in fields:
        due = []
        for item in status["pain_followup_due"][:2]:
            if not isinstance(item, dict) or not isinstance(item.get("region"), str) or \
                    not PAIN_ID.fullmatch(item["region"]) or item.get("side") not in (
                    "left", "right", "central"):
                fail("feedback status returned invalid pain identity")
            due.append(f"{item['side']} {item['region']}: current pain 0–10 NRS"
                       " (optional better/same/worse words)")
        if not due:
            fail("pain_change has no due pain identity")
        pieces.extend(due)
    return ("🌙 Quick evening check-in — only the missing pieces: " + "; ".join(pieces) +
            ". Reply naturally; skipping is fine and silence is never logged as an answer.")


def _marker_path(day):
    current = RUNTIME
    while current != VAULT and current != current.parent:
        if current.is_symlink():
            fail("feedback runtime symlink refused")
        current = current.parent
    if VAULT.is_symlink():
        fail("feedback vault symlink refused")
    RUNTIME.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(RUNTIME, 0o700)
    marker = RUNTIME / f"{day}.json"
    if marker.is_symlink():
        fail("feedback marker symlink refused")
    return marker


def _write_marker(path, value):
    data = (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()
    fd, name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "wb") as handle:
            os.fchmod(handle.fileno(), 0o600)
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(name, path)
        dfd = os.open(path.parent, os.O_RDONLY)
        try:
            os.fsync(dfd)
        finally:
            os.close(dfd)
    except BaseException:
        try:
            os.unlink(name)
        except FileNotFoundError:
            pass
        raise


def _sender():
    if os.environ.get("HERMES_FEEDBACK_TESTING") == "1" and os.environ.get("HERMES_FEEDBACK_SEND"):
        return os.environ["HERMES_FEEDBACK_SEND"]
    local = Path.home() / ".local/bin/hermes"
    return str(local if local.is_file() else Path("/usr/local/bin/hermes"))


def main():
    _configure_paths()
    now = datetime.now(TZ)
    day = os.environ.get("HERMES_FEEDBACK_DATE") if os.environ.get(
        "HERMES_FEEDBACK_TESTING") == "1" else None
    day = day or now.date().isoformat()
    status = _status(day)
    if not status["prompt_fields"]:
        emit({"ok": True, "status": "complete", "date": day, "sent": False})
    marker = _marker_path(day)
    if marker.exists():
        try:
            prior = json.loads(marker.read_text())
        except (OSError, ValueError):
            fail("existing feedback marker is unreadable")
        valid_prior = isinstance(prior, dict) and set(prior) == {
            "date", "prompt_fields", "payload_sha256", "send_time", "status"}
        valid_prior = valid_prior and prior.get("date") == day and \
            prior.get("status") in ("acknowledged", "uncertain") and \
            isinstance(prior.get("prompt_fields"), list) and \
            prior["prompt_fields"] == [field for field in FIELDS
                                        if field in prior["prompt_fields"]] and \
            isinstance(prior.get("payload_sha256"), str) and \
            re.fullmatch(r"[0-9a-f]{64}", prior["payload_sha256"]) and \
            isinstance(prior.get("send_time"), str)
        if valid_prior:
            emit({"ok": True, "status": "duplicate-suppressed", "date": day,
                  "prior_status": prior["status"], "sent": False})
        fail("existing feedback marker is invalid")
    prompt = _prompt(status)
    try:
        timeout = float(os.environ.get("HERMES_FEEDBACK_TIMEOUT", "45"))
    except ValueError:
        fail("invalid feedback send timeout")
    if not math.isfinite(timeout) or not 0.05 <= timeout <= 60:
        fail("invalid feedback send timeout")
    argv = [_sender(), "send", "--to", "telegram", prompt]
    send_env = {**os.environ, "XDG_RUNTIME_DIR": os.environ.get(
        "XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")}
    outcome = None
    for attempt in (1, 2):
        try:
            run = subprocess.run(argv, cwd=VAULT, env=send_env,
                                 capture_output=True, text=True, timeout=timeout)
            # A child that ran but failed may have dispatched before returning.
            outcome = "acknowledged" if run.returncode == 0 else "uncertain"
            break
        except subprocess.TimeoutExpired:
            outcome = "uncertain"  # post-dispatch ambiguity: never auto-retry
            break
        except OSError:
            if attempt == 2:
                fail("feedback send failed before dispatch after one retry")
    marker_value = {
        "date": day, "prompt_fields": status["prompt_fields"],
        "payload_sha256": hashlib.sha256(prompt.encode()).hexdigest(),
        "send_time": datetime.now(TZ).isoformat(), "status": outcome,
    }
    try:
        _write_marker(marker, marker_value)
    except OSError as exc:
        fail(f"send outcome could not be recorded: {exc.__class__.__name__}")
    emit({"ok": outcome == "acknowledged", "status": outcome, "date": day,
          "sent": outcome == "acknowledged"}, 0 if outcome == "acknowledged" else 1)


if __name__ == "__main__":
    main()
