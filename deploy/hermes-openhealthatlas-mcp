def _real_data_governance_configuration() -> dict[str, str]:
    """Load the explicit deny gate; this repository cannot activate real data."""

    if REAL_DATA_GOVERNANCE.is_symlink() or not REAL_DATA_GOVERNANCE.is_file():
        raise RuntimeError("real-data governance gate is unavailable")
    try:
        value = json.loads(REAL_DATA_GOVERNANCE.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise RuntimeError("real-data governance gate is unreadable") from exc
    expected = {
        "activation_allowed",
        "contract",
        "decisions",
        "fictional_tests_only",
        "missing_unknown_or_unapproved_action",
        "real_data_status",
        "version",
    }
    if not isinstance(value, dict) or set(value) != expected:
        raise RuntimeError("real-data governance gate has the wrong fields")
    decisions = value.get("decisions")
    if (
        value.get("contract") != "openhealthatlas-real-data-governance-gate-v1"
        or value.get("version") != "1.0.0"
        or value.get("activation_allowed") is not False
        or value.get("fictional_tests_only") is not True
        or value.get("missing_unknown_or_unapproved_action") != "deny"
        or value.get("real_data_status") != "blocked_unresolved_decisions"
        or not isinstance(decisions, dict)
        or set(decisions) != set(REAL_DATA_REQUIRED_DECISIONS)
        or any(
            not isinstance(decision, dict)
            or set(decision) != {"required", "status"}
            or decision.get("status") != "unresolved"
            or decision.get("required") != REAL_DATA_REQUIRED_DECISIONS[name]
            for name, decision in decisions.items()
        )
    ):
        raise RuntimeError("real-data governance gate must remain fail closed")
    return {
        "contract": value["contract"],
        "version": value["version"],
        "status": value["real_data_status"],
    }


def _fixture_configuration() -> tuple[str, str, str]:
    """Load the adapter's adjacent root-owned fictional fixture identity."""
    if CONFIG.is_symlink() or not CONFIG.is_file():
        raise RuntimeError("fictional tool configuration is unavailable")
    try:
        value = json.loads(CONFIG.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise RuntimeError("fictional tool configuration is unreadable") from exc
    if not isinstance(value, dict) or value.get("data_class") != "fictional":
        raise RuntimeError("MCP requires the fictional tool configuration")
    fixture_id = value.get("fixture_id")
    range_from = value.get("range_from")
    range_to = value.get("range_to")
    if not isinstance(fixture_id, str) or FIXTURE_ID_RE.fullmatch(fixture_id) is None:
        raise RuntimeError("fictional fixture identifier is invalid")
    try:
        start = date.fromisoformat(range_from)
        end = date.fromisoformat(range_to)
    except (TypeError, ValueError) as exc:
        raise RuntimeError("fictional fixture range is invalid") from exc
    if start.isoformat() != range_from or end.isoformat() != range_to or start > end:
        raise RuntimeError("fictional fixture range is invalid")
    return fixture_id, range_from, range_to


