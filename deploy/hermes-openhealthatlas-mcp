        "destination": "telegram_via_external_hermes_gateway",
        "destination_binding": "same_authenticated_gateway_source",
        "audience": "fictional_recovery_acceptance",
        "approved_range": {
            "from": RANGE_FROM,
            "to": RANGE_TO,
            "anchor": RANGE_TO,
        },
        "permitted_field_paths": _shared_field_paths(
            response_kind, focus, result
