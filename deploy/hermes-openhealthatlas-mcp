def _canonical(value: Any) -> str:
    return json.dumps(
        value, ensure_ascii=False, sort_keys=True, separators=(",", ":")
    )


def _sha256(value: Any) -> str:
    return "sha256:" + hashlib.sha256(_canonical(value).encode("utf-8")).hexdigest()


def _validated_sha256(value: object, label: str) -> str:
    if not isinstance(value, str) or SHA256_RE.fullmatch(value) is None:
        raise ValueError(f"governed readiness evidence has invalid {label}")
    return value


def _project_fields(value: object, fields: tuple[str, ...]) -> dict[str, Any]:
    if not isinstance(value, dict):
        raise ValueError("governed readiness evidence has an invalid object")
    return {
        key: deepcopy(value[key])
        for key in fields
        if key in value
    }


def _project_policy(value: object) -> dict[str, Any]:
    policy = _project_fields(value, POLICY_TOP_LEVEL_FIELDS)
    for name, fields in POLICY_SECTION_FIELDS.items():
        section = value.get(name) if isinstance(value, dict) else None
        if section is not None:
            policy[name] = _project_fields(section, fields)
    return policy


def _project_snapshot_integrity(value: object) -> dict[str, Any]:
    projected = _project_fields(value, SNAPSHOT_INTEGRITY_FIELDS)
    if set(projected) != set(SNAPSHOT_INTEGRITY_FIELDS):
        raise ValueError("governed readiness evidence lacks snapshot integrity")
    if (
        projected["contract"] != READINESS_ANCESTRY_CONTRACT
        or projected["status"] != "verified"
        or projected["scope"]
        != "current_snapshot_integrity_and_reproducibility"
        or projected["external_provider_sync"] != "not_performed"
        or projected["training_ancestry"] != "manifested"
        or not isinstance(projected["schema_version"], int)
        or isinstance(projected["schema_version"], bool)
    ):
        raise ValueError("governed readiness evidence has invalid snapshot integrity")
    return projected


def _readiness_evidence(result: dict[str, Any]) -> dict[str, Any] | None:
    """Project only the governed, non-raw readiness evidence to Hermes."""

    evidence = result.get("evidence")
    if (
        not isinstance(evidence, dict)
        or evidence.get("contract") != READINESS_EVIDENCE_CONTRACT
    ):
        return None
    projected: dict[str, Any] = {
        "contract": READINESS_EVIDENCE_CONTRACT,
        "input_fingerprint": _validated_sha256(
            evidence.get("input_fingerprint"), "input fingerprint"
        ),
        "fingerprint_scope": list(evidence.get("fingerprint_scope", [])),
        "policy": _project_policy(evidence.get("policy")),
        "policy_sha256": _validated_sha256(
            evidence.get("policy_sha256"), "policy identity"
        ),
        "public_evidence_identity": _validated_sha256(
            evidence.get("public_evidence_identity"), "public evidence identity"
        ),
        "snapshot_integrity": _project_snapshot_integrity(
            evidence.get("snapshot_integrity")
        ),
        "components": [],
        "soreness": None,
        "warnings": [],
        "remaining_ancestry_gaps": [],
    }
    for row in evidence.get("components", []):
        if not isinstance(row, dict):
            continue
        item = _project_fields(row, EVIDENCE_COMPONENT_FIELDS)
        current = row.get("current")
        baseline = row.get("baseline")
        item["current"] = (
            _project_fields(current, EVIDENCE_CURRENT_FIELDS)
            if isinstance(current, dict) else None
        )
        item["baseline"] = (
            _project_fields(baseline, EVIDENCE_BASELINE_FIELDS)
            if isinstance(baseline, dict) else None
        )
        # Baseline locators identify source rows without exposing their raw values.
        projected["components"].append(item)
    for row in evidence.get("warnings", []):
        projected["warnings"].append(
            _project_fields(row, EVIDENCE_WARNING_FIELDS)
        )
    for row in evidence.get("remaining_ancestry_gaps", []):
        projected["remaining_ancestry_gaps"].append(
            _project_fields(row, EVIDENCE_GAP_FIELDS)
        )
    soreness = evidence.get("soreness")
    if isinstance(soreness, dict):
        projected["soreness"] = {
            key: deepcopy(soreness.get(key))
            for key in (
                "status",
                "table",
                "locator",
                "source_label",
                "observed_at",
            )
        }
    if projected["policy_sha256"] != _sha256(projected["policy"]):
        raise ValueError("governed readiness evidence policy identity drifted")
    public_preimage = {
        key: deepcopy(value)
        for key, value in projected.items()
        if key != "public_evidence_identity"
    }
    if projected["public_evidence_identity"] != _sha256(public_preimage):
        raise ValueError("governed readiness public evidence identity drifted")
    return projected


def _soreness_summary(result: dict[str, Any]) -> dict[str, Any]:
    """Return presence and identity only; never return the qualitative text."""

    soreness = result.get("soreness")
    evidence = _readiness_evidence(result)
    evidence_soreness = evidence.get("soreness") if evidence is not None else None
    date_value = soreness.get("date") if isinstance(soreness, dict) else None
    summary: dict[str, Any] = {
        "present": isinstance(soreness, dict),
        "date": date_value,
    }
    if isinstance(evidence_soreness, dict):
        summary.update({
            "source_label": evidence_soreness.get("source_label"),
            "source_locator": evidence_soreness.get("locator"),
        })
    return summary


def _model_readiness_result(result: dict[str, Any]) -> dict[str, Any]:
    """Bound the model-facing result and strip every raw qualitative value."""

    projected = _project_fields(
        result,
        ("status", "anchor_date", "range_from", "reason", "score", "band"),
    )
    projected["components"] = [
        _project_fields(row, MODEL_COMPONENT_FIELDS)
        for row in result.get("components", [])
    ]
    if "drag" in result:
        projected["drag"] = [
            _project_fields(row, MODEL_DRAG_FIELDS)
            for row in result.get("drag", [])
        ]
    projected["muscle_recovery"] = [
        _project_fields(row, MODEL_MUSCLE_FIELDS)
        for row in result.get("muscle_recovery", [])
    ]
    projected["disclaimer"] = RECOVERY_NON_DIAGNOSTIC_TEXT
    projected["soreness"] = _soreness_summary(result)
    evidence = _readiness_evidence(result)
    if evidence is not None:
        projected["evidence"] = evidence
    return projected


def _public_result_sha256(response_kind: str, projection: dict[str, Any]) -> str:
    """Identify only an exact privacy-safe MCP projection."""

    return _sha256({
        "contract": f"openhealthatlas-public-recovery-{response_kind}-v1",
        "projection": projection,
    })


def _shared_field_groups(response_kind: str, focus: str | None) -> list[str]:
    groups = []
    if response_kind == "snapshot" or focus in {"sleep", "heart_signals"}:
        groups.append("derived_recovery_components")
    if response_kind == "snapshot" or focus == "training":
        groups.append("derived_training_recovery")
    if response_kind == "snapshot" or focus == "soreness":
        groups.append("derived_soreness_flags")
    groups.extend(["governed_evidence_identity", "component_missingness"])
    return groups


def _shared_field_paths(
    response_kind: str,
    focus: str | None,
    result: dict[str, Any],
) -> list[str]:
    common = [
        "data_class",
        "fixture_id",
        "turn_id",
        "result_sha256",
        "missing[]",
        "required_disclosure",
        "reply_requirement",
        "sharing_authorization",
        "delivery_contract",
    ]
    if response_kind == "snapshot":
        model_result = _model_readiness_result(result)
        paths = []
        for key in (
            "status",
            "anchor_date",
            "range_from",
            "reason",
            "score",
            "band",
            "components",
            "drag",
            "muscle_recovery",
            "soreness",
            "disclaimer",
            "evidence",
        ):
            if key not in model_result:
                continue
            suffix = {
                "components": "[]",
                "drag": "[]",
                "muscle_recovery": "[]",
                "soreness": (
                    ".{present,date,source_label,source_locator}"
                ),
            }.get(key, "")
            paths.append(f"result.{key}{suffix}")
        return common + paths + ["follow_up_required"]
    detail_path = {
        "sleep": "detail[]",
        "heart_signals": "detail[]",
        "training": "detail[]",
        "soreness": (
            "detail.{soreness,flagged_groups[]}"
        ),
    }.get(focus, "detail")
    return common + [
        "status",
        "focus",
        "deterministic_components",
        detail_path,
        "evidence",
        "disclaimer",
        "instruction",
    ]


def _sharing_authorization(
    *, response_kind: str, focus: str | None, result: dict[str, Any]
) -> dict[str, Any]:
    """Return destination authorization without changing OHA calculation identity."""

    if response_kind == "snapshot":
        qualitative_paths = [
            "result.soreness.present",
            "result.soreness.date",
            "result.soreness.source_label",
            "result.soreness.source_locator",
            "result.muscle_recovery[].sore",
        ]
    elif focus == "soreness":
        qualitative_paths = [
            "detail.soreness.present",
            "detail.soreness.date",
            "detail.soreness.source_label",
            "detail.soreness.source_locator",
            "detail.flagged_groups[].sore",
        ]
    elif focus == "training":
        qualitative_paths = ["detail[].sore"]
    else:
        qualitative_paths = []
    return {
        "contract": RECOVERY_SHARING_AUTHORIZATION_CONTRACT,
        "authorization_id": RECOVERY_SHARING_AUTHORIZATION_ID,
        "version": RECOVERY_SHARING_AUTHORIZATION_VERSION,
