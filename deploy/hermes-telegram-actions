#!/usr/bin/env python3
"""Tap-first Telegram actions for Hermes.

The Hermes Telegram adapter owns inbound updates.  It delegates only callback
data beginning with ``hx:`` and registered message reactions to this program.
This program owns the small interaction ledger, while every quantitative
health write still goes through the canonical ``health.py`` CLI.
"""

from __future__ import annotations

import argparse
import json
import os
import secrets
import sqlite3
import stat
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request
from datetime import datetime, timedelta
from pathlib import Path
from zoneinfo import ZoneInfo


TZ = ZoneInfo(os.environ.get("HERMES_TIMEZONE", "UTC"))
DEFAULT_DATA = Path(os.environ.get(
    "HERMES_DATA_DIR", Path.home() / ".local" / "share" / "hermes"
))
DEFAULT_HOME = Path(os.environ.get("HERMES_AGENT_HOME", Path.home() / ".hermes"))
DEFAULT_HEALTH = Path(os.environ.get("HERMES_HEALTH_CLI", "/opt/hermes/toolkit/health.py"))
DEFAULT_STATE = DEFAULT_DATA / "runtime" / "telegram-actions"
HEARTS = {"❤", "❤️"}
VALID_TASK_STATES = {"pending", "started", "done", "partial", "blocked", "snoozed"}


def _now() -> datetime:
    return datetime.now(TZ)


def _emit(value: dict, code: int = 0) -> None:
    print(json.dumps(value, ensure_ascii=False, sort_keys=True))
    raise SystemExit(code)


def _testing() -> bool:
    return os.environ.get("HERMES_TELEGRAM_ACTIONS_TESTING") == "1"


def _path(name: str, default: Path) -> Path:
    override = os.environ.get(name)
    return Path(override) if override else default


def _home() -> Path:
    return _path("HERMES_TELEGRAM_ACTIONS_HOME", DEFAULT_HOME)


def _health() -> Path:
    return _path("HERMES_TELEGRAM_ACTIONS_HEALTH", DEFAULT_HEALTH)


def _state() -> Path:
    return _path("HERMES_TELEGRAM_ACTIONS_STATE", DEFAULT_STATE)


def _load_env() -> dict[str, str]:
    values = dict(os.environ)
    credentials_dir = os.environ.get("CREDENTIALS_DIRECTORY")
    env_file = Path(os.environ.get(
        "HERMES_TELEGRAM_ACTIONS_ENV",
        str(Path(credentials_dir) / "telegram.env")
        if credentials_dir else str(_home() / ".env"),
    ))
    if not env_file.exists():
        return values
    try:
        metadata = env_file.lstat()
    except OSError as exc:
        _emit({"ok": False, "error": f"Telegram credential file unavailable: {exc.__class__.__name__}"}, 2)
    if env_file.is_symlink() or not stat.S_ISREG(metadata.st_mode):
        _emit({"ok": False, "error": "Telegram credential file must be regular"}, 2)
    if metadata.st_mode & 0o077 or metadata.st_uid not in {0, os.geteuid()}:
        _emit({"ok": False, "error": "Telegram credential file must be owner-controlled mode 0600"}, 2)
    for raw in env_file.read_text(errors="replace").splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        key = key.strip()
        value = value.strip().strip("\"'")
        values.setdefault(key, value)
    return values


def _owner_id(env: dict[str, str]) -> str | None:
    raw = env.get("TELEGRAM_ALLOWED_USERS", "")
    values = [item.strip() for item in raw.split(",") if item.strip()]
    return values[0] if len(values) == 1 else None


def _chat_id(env: dict[str, str], supplied: str | None) -> str:
    value = supplied or env.get("TELEGRAM_HOME_CHANNEL") or env.get("TELEGRAM_CHAT_ID")
    if not value:
        _emit({"ok": False, "error": "Telegram home channel is not configured"}, 2)
    return str(value)


def _connect() -> sqlite3.Connection:
    root = _state()
    root.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(root, 0o700)
    db = root / "actions.sqlite3"
    if db.is_symlink():
        _emit({"ok": False, "error": "action database symlink refused"}, 2)
    cx = sqlite3.connect(db, timeout=15)
    cx.row_factory = sqlite3.Row
    cx.executescript(
        """
        PRAGMA journal_mode=WAL;
        PRAGMA foreign_keys=ON;
        CREATE TABLE IF NOT EXISTS cards(
          token TEXT PRIMARY KEY,
          dedupe_key TEXT UNIQUE,
          chat_id TEXT NOT NULL,
          message_id TEXT,
          owner_user_id TEXT,
          kind TEXT NOT NULL,
          action_date TEXT NOT NULL,
          payload_json TEXT NOT NULL,
          original_text TEXT NOT NULL,
          keyboard_json TEXT NOT NULL,
          created_at TEXT NOT NULL,
          expires_at TEXT NOT NULL,
          updated_at TEXT NOT NULL
        );
        CREATE INDEX IF NOT EXISTS cards_message
          ON cards(chat_id, message_id);
        CREATE TABLE IF NOT EXISTS action_events(
          event_key TEXT PRIMARY KEY,
          token TEXT NOT NULL REFERENCES cards(token),
          event_type TEXT NOT NULL,
          user_id TEXT NOT NULL,
          action_code TEXT NOT NULL,
          status TEXT NOT NULL,
          response_json TEXT,
          created_at TEXT NOT NULL,
          updated_at TEXT NOT NULL
        );
        """
    )
    try:
        os.chmod(db, 0o600)
    except OSError:
        pass
    return cx


def _token() -> str:
    return secrets.token_urlsafe(8)


def _button(text: str, token: str, code: str) -> dict:
    data = f"hx:{token}:{code}"
    if len(data.encode()) > 64:
        raise ValueError("callback data exceeds Telegram's 64-byte limit")
    return {"text": text, "callback_data": data}


def _api_send(env: dict[str, str], chat_id: str, text: str, keyboard: list[list[dict]]) -> str:
    outbox = os.environ.get("HERMES_TELEGRAM_ACTIONS_OUTBOX")
    if outbox:
        if not _testing():
            _emit({"ok": False, "error": "outbox override is test-only"}, 2)
        path = Path(outbox)
        messages = json.loads(path.read_text()) if path.exists() else []
        message_id = str(100 + len(messages) + 1)
        messages.append({
            "chat_id": chat_id,
            "text": text,
            "reply_markup": {"inline_keyboard": keyboard},
            "message_id": message_id,
        })
        path.write_text(json.dumps(messages, ensure_ascii=False, sort_keys=True))
        return message_id
    token = env.get("TELEGRAM_BOT_TOKEN")
    if not token:
        _emit({"ok": False, "error": "Telegram bot token is not configured"}, 2)
    base = os.environ.get("HERMES_TELEGRAM_ACTIONS_API_BASE", "https://api.telegram.org")
    if os.environ.get("HERMES_TELEGRAM_ACTIONS_API_BASE") and not _testing():
        _emit({"ok": False, "error": "API base override is test-only"}, 2)
    fields = {
        "chat_id": chat_id,
        "text": text,
        "disable_web_page_preview": "true",
    }
    if keyboard:
        fields["reply_markup"] = json.dumps(
            {"inline_keyboard": keyboard}, ensure_ascii=False
        )
    body = urllib.parse.urlencode(fields).encode()
    request = urllib.request.Request(
        f"{base.rstrip('/')}/bot{token}/sendMessage",
        data=body,
        method="POST",
    )
    try:
        with urllib.request.urlopen(request, timeout=20) as response:
            value = json.loads(response.read())
    except (OSError, urllib.error.URLError, ValueError) as exc:
        _emit({"ok": False, "error": f"Telegram send failed: {exc.__class__.__name__}"}, 1)
    if not value.get("ok") or not isinstance(value.get("result"), dict):
        _emit({"ok": False, "error": "Telegram rejected the message"}, 1)
    return str(value["result"]["message_id"])


def _reserve_card(
    *,
    kind: str,
    action_date: str,
    text: str,
    codes: list[list[tuple[str, str]]],
    payload: dict,
    dedupe_key: str | None,
    chat_id: str | None,
    expiry_hours: int = 36,
) -> dict:
    env = _load_env()
    destination = _chat_id(env, chat_id)
    cx = _connect()
    if dedupe_key:
        prior = cx.execute(
            "SELECT token, message_id FROM cards WHERE dedupe_key=?", (dedupe_key,)
        ).fetchone()
        if prior and prior["message_id"]:
            return {
                "ok": True,
                "sent": False,
                "duplicate_suppressed": True,
                "token": prior["token"],
                "message_id": prior["message_id"],
            }
        if prior:
            cx.execute("DELETE FROM cards WHERE token=?", (prior["token"],))
            cx.commit()
    token = _token()
    keyboard = [[_button(label, token, code) for label, code in row] for row in codes]
    created = _now()
    values = (
        token,
        dedupe_key,
        destination,
        None,
        _owner_id(env),
        kind,
        action_date,
        json.dumps(payload, ensure_ascii=False, sort_keys=True),
        text,
        json.dumps(keyboard, ensure_ascii=False, sort_keys=True),
        created.isoformat(),
        (created + timedelta(hours=expiry_hours)).isoformat(),
        created.isoformat(),
    )
    cx.execute(
        """INSERT INTO cards(
             token,dedupe_key,chat_id,message_id,owner_user_id,kind,action_date,
             payload_json,original_text,keyboard_json,created_at,expires_at,updated_at
           ) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?)""",
        values,
    )
    cx.commit()
    try:
        message_id = _api_send(env, destination, text, keyboard)
    except SystemExit:
        cx.execute("DELETE FROM cards WHERE token=? AND message_id IS NULL", (token,))
        cx.commit()
        raise
    cx.execute(
        "UPDATE cards SET message_id=?,updated_at=? WHERE token=?",
        (message_id, _now().isoformat(), token),
    )
    cx.commit()
    return {"ok": True, "sent": True, "token": token, "message_id": message_id}


def _send_checkin(args: argparse.Namespace) -> dict:
    day = args.date or _now().date().isoformat()
    slot_label = "Morning" if args.slot == "am" else "Afternoon"
    text = (
        f"⚡ {slot_label} check-in\n"
        "Tap energy, focus, and any water you drank. Each tap logs immediately."
    )
    rows = [
        [(f"Energy {value}", f"e{value}") for value in range(1, 6)],
        [(f"Focus {value}", f"f{value}") for value in range(1, 6)],
        [("+250 ml", "w250"), ("+500 ml", "w500"), ("+1 L", "w1000")],
    ]
    return _reserve_card(
        kind="checkin",
        action_date=day,
        text=text,
        codes=rows,
        payload={"slot": args.slot},
        dedupe_key=f"checkin:{day}:{args.slot}",
        chat_id=args.chat_id,
    )


