def _feedback_status(day: str) -> dict:
    value = _run_health("feedback-status", "--date", day)
    if value.get("date") != day or not isinstance(value.get("prompt_fields"), list):
        raise RuntimeError("feedback status returned invalid data")
    return value


def _send_evening(args: argparse.Namespace) -> dict:
    day = args.date or _now().date().isoformat()
    status = _feedback_status(day)
    sent = []
    if "day_rating" in status["prompt_fields"]:
        sent.append(_reserve_card(
            kind="rating",
            action_date=day,
            text="🌙 How was today overall?",
            codes=[[("🔴 Red", "rred"), ("🟡 Yellow", "ryellow"), ("🟢 Green", "rgreen")]],
            payload={},
            dedupe_key=f"rating:{day}",
            chat_id=args.chat_id,
        ))
    if "whole_day_word" in status["prompt_fields"]:
        sent.append(_reserve_card(
            kind="word",
            action_date=day,
            text="Did you keep your word to yourself today?",
            codes=[[("Broke", "wb"), ("Partly", "wp"), ("Kept", "wk")]],
            payload={},
            dedupe_key=f"word:{day}",
            chat_id=args.chat_id,
        ))
    if "mood" in status["prompt_fields"]:
        sent.append(_reserve_card(
            kind="mood",
            action_date=day,
            text="Mood right now?",
            codes=[[(str(value), f"m{value}") for value in range(1, 6)]],
            payload={},
            dedupe_key=f"mood:{day}:evening",
            chat_id=args.chat_id,
        ))
    commitments = status.get("active_commitments_missing_log") or []
    if not isinstance(commitments, list):
        raise RuntimeError("feedback status returned invalid commitments")
    for item in commitments[:5]:
        if not isinstance(item, dict) or not isinstance(item.get("id"), int) or \
                not isinstance(item.get("name"), str):
            raise RuntimeError("feedback status returned invalid commitment")
        sent.append(_reserve_card(
            kind="commitment",
            action_date=day,
            text=f"Commitment: {item['name']}",
            codes=[[("Broke", "cb"), ("Partly", "cp"), ("Kept", "ck")]],
            payload={"commitment_id": item["id"], "name": item["name"]},
            dedupe_key=f"commitment:{day}:{item['id']}",
            chat_id=args.chat_id,
        ))
    pain = status.get("pain_followup_due") or []
    if pain:
        parts = []
        for item in pain[:2]:
            if not isinstance(item, dict):
                continue
            region, side = item.get("region"), item.get("side")
            if isinstance(region, str) and isinstance(side, str):
                parts.append(f"{side} {region}")
        if parts:
            env = _load_env()
            destination = _chat_id(env, args.chat_id)
            _api_send(
                env,
                destination,
                "Pain check: reply with today's 0–10 number for " + " and ".join(parts) + ".",
                [],
            )
            sent.append({"ok": True, "sent": True, "kind": "pain"})
    return {
        "ok": True,
        "date": day,
        "sent_count": sum(1 for item in sent if item.get("sent")),
        "duplicate_count": sum(1 for item in sent if item.get("duplicate_suppressed")),
        "complete": not sent,
    }


def _run_health(*parts: str) -> dict:
    command = [sys.executable, str(_health()), *parts]
    try:
        run = subprocess.run(
            command,
            cwd=_health().parent,
            capture_output=True,
            text=True,
            timeout=45,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise RuntimeError(f"health toolkit unavailable: {exc.__class__.__name__}") from exc
    if run.returncode != 0:
        message = (run.stderr or run.stdout or "health toolkit failed").strip().splitlines()[-1]
        raise RuntimeError(message[:180])
    try:
        value = json.loads(run.stdout)
    except ValueError as exc:
        raise RuntimeError("health toolkit returned invalid JSON") from exc
    if not isinstance(value, dict) or value.get("ok") is not True:
        raise RuntimeError("health toolkit rejected the action")
    return value


def _claim_event(cx: sqlite3.Connection, key: str, token: str, event_type: str,
                 user_id: str, code: str) -> dict | None:
    now = _now().isoformat()
    try:
        cx.execute(
            """INSERT INTO action_events(
                 event_key,token,event_type,user_id,action_code,status,created_at,updated_at
               ) VALUES(?,?,?,?,?,'processing',?,?)""",
            (key, token, event_type, user_id, code, now, now),
        )
        cx.commit()
        return None
    except sqlite3.IntegrityError:
        row = cx.execute(
            "SELECT status,response_json FROM action_events WHERE event_key=?", (key,)
        ).fetchone()
        if row and row["response_json"]:
            return json.loads(row["response_json"])
        return {"ok": True, "answer_text": "Already received.", "idempotent": True}


def _finish_event(cx: sqlite3.Connection, key: str, response: dict, status: str) -> dict:
    cx.execute(
        "UPDATE action_events SET status=?,response_json=?,updated_at=? WHERE event_key=?",
        (status, json.dumps(response, ensure_ascii=False, sort_keys=True),
         _now().isoformat(), key),
    )
    cx.commit()
    return response


def _update_task(cx: sqlite3.Connection, card: sqlite3.Row, state: str) -> dict:
    if state not in VALID_TASK_STATES:
        raise RuntimeError("invalid task state")
    payload = json.loads(card["payload_json"])
    previous = payload.get("status", "pending")
    payload["status"] = state
    payload["status_at"] = _now().isoformat()
    cx.execute(
        "UPDATE cards SET payload_json=?,updated_at=? WHERE token=?",
        (json.dumps(payload, ensure_ascii=False, sort_keys=True),
         _now().isoformat(), card["token"]),
    )
    cx.commit()
    if state == "done" and payload.get("commitment_id"):
        _run_health(
            "log-commitment", "kept", "--id", str(payload["commitment_id"]),
            "--date", card["action_date"], "--source", "chat-telegram",
        )
    labels = {
        "started": "▶️ Started",
        "done": "✅ Done",
        "partial": "🟡 Partial counts",
        "blocked": f"🧱 Blocked — do the floor: {payload.get('floor') or 'make it two minutes'}",
    }
    suffix = labels[state]
    edit_text = card["original_text"].split("\n\n— ")[0] + f"\n\n— {suffix}"
    return {
        "ok": True,
        "answer_text": suffix,
        "edit_text": edit_text,
        "remove_keyboard": state == "done",
        "task_status": state,
        "previous_status": previous,
    }


def _select_option(cx: sqlite3.Connection, card: sqlite3.Row) -> dict:
    payload = json.loads(card["payload_json"])
    payload["status"] = "selected"
    payload["selected_at"] = _now().isoformat()
    cx.execute(
        "UPDATE cards SET payload_json=?,updated_at=? WHERE token=?",
        (json.dumps(payload, ensure_ascii=False, sort_keys=True),
         _now().isoformat(), card["token"]),
    )
    cx.commit()
    edit_text = card["original_text"].split("\n\n— ")[0] + "\n\n— ❤️ Selected"
    return {
        "ok": True,
        "edit_text": edit_text,
        "remove_keyboard": True,
        "selection_status": "selected",
    }


def _execute(cx: sqlite3.Connection, card: sqlite3.Row, code: str) -> dict:
    day = card["action_date"]
    payload = json.loads(card["payload_json"])
    if code in {"w250", "w500", "w1000"}:
        amount = int(code[1:])
        value = _run_health("water-add", str(amount), "--date", day)
        return {
            "ok": True,
            "answer_text": (
                f"+{amount} ml · {int(value['total_ml'])} / {int(value['target_ml'])} ml today"
            ),
        }
    if len(code) == 2 and code[0] in {"e", "f", "m"} and code[1] in "12345":
        kind = {"e": "energy", "f": "focus", "m": "mood"}[code[0]]
        value = int(code[1])
        _run_health(
            "checkin", kind, str(value), "--date", day, "--source", "chat-telegram"
        )
        return {"ok": True, "answer_text": f"{kind.title()} {value}/5 logged"}
    if code in {"rred", "ryellow", "rgreen"}:
        rating = code[1:]
        _run_health("day-rating", rating, "--date", day, "--source", "chat-telegram")
        emoji = {"red": "🔴", "yellow": "🟡", "green": "🟢"}[rating]
        return {"ok": True, "answer_text": f"{emoji} {rating.title()} day logged"}
    if code in {"wb", "wp", "wk"}:
        status = {"wb": "broke", "wp": "partly", "wk": "kept"}[code]
        _run_health(
            "log-commitment", status, "--date", day, "--source", "chat-telegram"
        )
        return {"ok": True, "answer_text": f"Word: {status} logged"}
    if code in {"cb", "cp", "ck"} and payload.get("commitment_id"):
        status = {"cb": "broke", "cp": "partly", "ck": "kept"}[code]
        _run_health(
            "log-commitment", status, "--id", str(payload["commitment_id"]),
            "--date", day, "--source", "chat-telegram",
        )
        return {"ok": True, "answer_text": f"{payload.get('name', 'Commitment')}: {status}"}
    if card["kind"] == "task" and code in {"ts", "td", "tp", "tb"}:
        state = {"ts": "started", "td": "done", "tp": "partial", "tb": "blocked"}[code]
        return _update_task(cx, card, state)
    raise RuntimeError("action is not valid for this card")


def _validate_card(card: sqlite3.Row, event: dict) -> None:
    if not card["message_id"]:
        raise RuntimeError("card is not active")
    if str(event.get("chat_id")) != card["chat_id"] or \
            str(event.get("message_id")) != card["message_id"]:
        raise RuntimeError("card binding mismatch")
    if card["owner_user_id"] and str(event.get("user_id")) != card["owner_user_id"]:
        raise RuntimeError("wrong card owner")
    if datetime.fromisoformat(card["expires_at"]) < _now():
        raise RuntimeError("this card expired")


def _dispatch_callback(event: dict) -> dict:
    data = str(event.get("data", ""))
    parts = data.split(":", 2)
    if len(parts) != 3 or parts[0] != "hx":
        return {"ok": False, "answer_text": "Invalid action."}
    token, code = parts[1], parts[2]
    cx = _connect()
    card = cx.execute("SELECT * FROM cards WHERE token=?", (token,)).fetchone()
    if not card:
        return {"ok": False, "answer_text": "This action expired."}
    try:
        _validate_card(card, event)
    except RuntimeError as exc:
        return {"ok": False, "answer_text": str(exc)}
    key = f"callback:{event.get('query_id')}"
    prior = _claim_event(cx, key, token, "callback", str(event.get("user_id")), code)
    if prior:
        return prior
    try:
        response = _execute(cx, card, code)
        return _finish_event(cx, key, response, "done")
    except Exception as exc:
        response = {"ok": False, "answer_text": f"Could not log: {str(exc)[:120]}"}
        return _finish_event(cx, key, response, "failed")


def _reaction_emojis(value: object) -> set[str]:
    result = set()
    if isinstance(value, list):
        for item in value:
            if isinstance(item, dict) and isinstance(item.get("emoji"), str):
                result.add(item["emoji"])
    return result


def _dispatch_reaction(event: dict) -> dict:
    old = _reaction_emojis(event.get("old_reaction"))
    new = _reaction_emojis(event.get("new_reaction"))
    if not (new & HEARTS) or old & HEARTS:
        return {"ok": True, "ignored": True}
    cx = _connect()
    card = cx.execute(
        "SELECT * FROM cards WHERE chat_id=? AND message_id=? ORDER BY created_at DESC LIMIT 1",
        (str(event.get("chat_id")), str(event.get("message_id"))),
    ).fetchone()
    if not card or card["kind"] not in {"task", "option"}:
        return {"ok": True, "ignored": True}
    try:
        _validate_card(card, event)
    except RuntimeError:
        return {"ok": True, "ignored": True}
    key = f"reaction:{event.get('update_id')}"
    prior = _claim_event(
        cx, key, card["token"], "reaction", str(event.get("user_id")), "td"
    )
    if prior:
        return prior
    try:
        response = (
            _update_task(cx, card, "done")
            if card["kind"] == "task"
            else _select_option(cx, card)
        )
        return _finish_event(cx, key, response, "done")
    except Exception as exc:
        return _finish_event(
            cx, key, {"ok": False, "error": str(exc)[:120]}, "failed"
        )


def _dispatch(args: argparse.Namespace) -> dict:
    try:
        event = json.load(sys.stdin)
    except ValueError:
        return {"ok": False, "answer_text": "Invalid action payload."}
    if not isinstance(event, dict):
        return {"ok": False, "answer_text": "Invalid action payload."}
    return _dispatch_callback(event) if args.kind == "callback" else _dispatch_reaction(event)


def _list_tasks(args: argparse.Namespace) -> dict:
    day = args.date or _now().date().isoformat()
    cx = _connect()
    rows = []
    for card in cx.execute(
        """SELECT token,action_date,payload_json,created_at,updated_at
           FROM cards WHERE kind='task' AND action_date=?
           ORDER BY created_at""",
        (day,),
    ):
        payload = json.loads(card["payload_json"])
        rows.append({
            "token": card["token"],
            "date": card["action_date"],
            "title": payload.get("title"),
            "goal": payload.get("goal"),
            "floor": payload.get("floor"),
            "at": payload.get("at"),
            "status": payload.get("status", "pending"),
            "updated_at": card["updated_at"],
        })
    return {"ok": True, "date": day, "tasks": rows}


def _list_options(args: argparse.Namespace) -> dict:
    cx = _connect()
    query = """SELECT token,action_date,payload_json,updated_at
               FROM cards WHERE kind='option'"""
    params: list[str] = []
    if args.group:
        query += " AND json_extract(payload_json, '$.group')=?"
        params.append(args.group)
    query += " ORDER BY created_at"
    rows = []
    for card in cx.execute(query, params):
        payload = json.loads(card["payload_json"])
        rows.append({
            "token": card["token"],
            "date": card["action_date"],
            "group": payload.get("group"),
            "option": payload.get("option"),
            "status": payload.get("status", "available"),
            "updated_at": card["updated_at"],
        })
    return {"ok": True, "group": args.group, "options": rows}


def _add_common_send(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--date")
    parser.add_argument("--chat-id")
    parser.add_argument("--text")
    parser.add_argument("--dedupe-key")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)

    checkin = sub.add_parser("send-checkin")
    checkin.add_argument("--slot", choices=("am", "pm"), required=True)
    checkin.add_argument("--date")
    checkin.add_argument("--chat-id")
    checkin.set_defaults(fn=_send_checkin)

    for name, fn in (
        ("send-water", _send_water),
        ("send-rating", _send_rating),
        ("send-word", _send_word),
        ("send-mood", _send_mood),
    ):
        item = sub.add_parser(name)
        _add_common_send(item)
        item.set_defaults(fn=fn)

    commitment = sub.add_parser("send-commitment")
    _add_common_send(commitment)
    commitment.add_argument("--id", type=int, required=True)
    commitment.add_argument("--name", required=True)
    commitment.set_defaults(fn=_send_commitment)

    task = sub.add_parser("send-task")
    task.add_argument("--title", required=True)
    task.add_argument("--goal")
    task.add_argument("--floor")
    task.add_argument("--at")
    task.add_argument("--date")
    task.add_argument("--chat-id")
    task.add_argument("--dedupe-key")
    task.add_argument("--commitment-id", type=int)
    task.set_defaults(fn=_send_task)

    option = sub.add_parser("send-option")
    option.add_argument("--group", required=True)
    option.add_argument("--option", required=True)
    option.add_argument("--context")
    option.add_argument("--date")
    option.add_argument("--chat-id")
    option.add_argument("--dedupe-key")
    option.set_defaults(fn=_send_option)

    evening = sub.add_parser("send-evening")
    evening.add_argument("--date")
    evening.add_argument("--chat-id")
    evening.set_defaults(fn=_send_evening)

    dispatch = sub.add_parser("dispatch")
    dispatch.add_argument("kind", choices=("callback", "reaction"))
    dispatch.set_defaults(fn=_dispatch)

    tasks = sub.add_parser("list-tasks")
    tasks.add_argument("--date")
    tasks.set_defaults(fn=_list_tasks)

    options = sub.add_parser("list-options")
    options.add_argument("--group")
    options.set_defaults(fn=_list_options)
    return parser


def main() -> None:
    args = build_parser().parse_args()
    result = args.fn(args)
    _emit(result, 0 if result.get("ok") else 1)


if __name__ == "__main__":
    main()
