def _send_task(args: argparse.Namespace) -> dict:
    day = args.date or _now().date().isoformat()
    lines = [f"🎯 {args.title}"]
    if args.goal:
        lines.append(f"Why: {args.goal}")
    if args.at:
        lines.append(f"When: {args.at}")
    if args.floor:
        lines.append(f"Can't-fail floor: {args.floor}")
    lines.append("Double-tap ❤️ = done.")
    return _reserve_card(
        kind="task",
        action_date=day,
        text="\n".join(lines),
        codes=[[("▶️ Start", "ts"), ("✅ Done", "td")],
               [("🟡 Partial", "tp"), ("🧱 Blocked", "tb")]],
        payload={
            "title": args.title,
            "goal": args.goal,
            "floor": args.floor,
            "at": args.at,
            "status": "pending",
            "commitment_id": args.commitment_id,
        },
        dedupe_key=args.dedupe_key,
        chat_id=args.chat_id,
        expiry_hours=72,
    )


