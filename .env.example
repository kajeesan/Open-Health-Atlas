# Copy values into an external environment file; do not commit the populated file.
HERMES_DATA_DIR=/var/lib/hermes
HEALTH_DB=/var/lib/hermes/health.db
PANEL_DB=/var/lib/hermes/panel/panel.db
VAULT_DIR=/var/lib/hermes/vault
HERMES_TIMEZONE=UTC
HERMES_DISPLAY_NAME=Hermes user
# Neutral default used by medication charts. Change this to the exact label
# used in your own meds_log. Optional comma-separated aliases remain local.
HERMES_PRIMARY_MEDICATION=medication
HERMES_MEDICATION_ALIASES=

# Optional per-user nutrient targets. No demographic targets are assumed when
# this is empty. Values are examples only; choose appropriate values yourself.
HERMES_NUTRIENT_TARGETS_JSON={}

# Optional protocol-specific mobility comparison. Empty means no demographic
# sit-and-reach threshold is assumed.
HERMES_SIT_REACH_NORMAL_CM=

# Optional user-chosen nutrition model values. Empty means the automated target
# engine remains unavailable; manual logged data is still preserved.
HERMES_PHASE_OFFSETS_JSON={}
HERMES_PROTEIN_PER_KG_JSON={}
HERMES_WATER_FALLBACK_ML=2000
HERMES_WATER_ML_PER_KG=30
HERMES_WATER_ML_PER_EXERCISE_HOUR=500
HERMES_WATER_HOT_DAY_BONUS_ML=300
HERMES_WATER_HOT_DAY_TEMP_C=26
# Archive/package deployments without .git set this to their exact 40-character
# source commit before running a schema migration.
# HERMES_CODE_VERSION=replace-with-packaged-git-commit

# Keep these stable after enrolling a passkey.
PANEL_USER_ID=hermes-user
PANEL_USER_NAME=hermes-user
PANEL_RP_ID=localhost
PANEL_ORIGIN=http://localhost:5111
PANEL_COOKIE_SECURE=0

# Generate a long random value for every production installation.
PANEL_SECRET_KEY=replace-with-a-random-secret

# Optional external integrations. Users create these files/services themselves.
BRIDGE_SOCKET=/run/hermes-bridge/bridge.sock
HERMES_HEVY_QUARTERLY_CONFIG=/etc/hermes/hevy-quarterly.json
